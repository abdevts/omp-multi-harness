{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup: check",
      "type": "shell",
      "command": "bun scripts/setup.ts check",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "setup: fix",
      "type": "shell",
      "command": "bun scripts/setup.ts fix",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "bun run typecheck",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "bun test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "omp: run with extension",
      "type": "shell",
      "command": "omp --no-extensions -e ./src/index.ts",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
